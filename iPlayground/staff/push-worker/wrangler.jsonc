{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iplayground-reminders",
  "main": "src/index.js",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGIN": "https://gztin.github.io",
    "VAPID_PUBLIC_KEY": "REPLACE_WITH_VAPID_PUBLIC_KEY"
  },
  "d1_databases": [
    {
      "binding": "REMINDERS",
      "database_name": "iplayground-reminders",
      "database_id": "REPLACE_AFTER_D1_CREATE"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
